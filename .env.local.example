DATABASE_URL=postgresql://extracto:extracto@localhost:5432/extracto

# URL del daemon de Ollama (arráncalo con `ollama serve`, suele quedar ya corriendo tras instalarlo).
OLLAMA_BASE_URL=http://localhost:11434
# Modelo con visión usado para extraer datos de imágenes/PDFs (descárgalo con `ollama pull llama3.2-vision`).
OLLAMA_VISION_MODEL=llama3.2-vision
# Modelo de embeddings (768 dims) usado al guardar documentos y al buscar en el chat
# (`ollama pull nomic-embed-text`). Si cambias de modelo y cambia la dimensión, actualiza
# también `VECTOR(768)` en db/init.sql y recrea el volumen (`docker compose down -v`).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Modelo de texto usado por el chat: decide si una pregunta necesita SQL o búsqueda
# semántica, y redacta las respuestas (`ollama pull llama3.1`).
OLLAMA_CHAT_MODEL=llama3.1
